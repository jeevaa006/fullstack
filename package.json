{
  "name": "carebridge-rural-healthcare",
  "version": "1.0.0",
  "description": "CareBridge — Rural Healthcare Support Platform, Kumaraguru College of Technology Project 14",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "nodemon index.js",
    "setup": "npm install && npm --prefix client install",
    "seed": "node scripts/seedDatabase.js",
    "db:backup": "node scripts/dbBackup.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "test": "node --test"
  },
  "keywords": [
    "carebridge",
    "healthcare",
    "mern"
  ],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "4.22.3",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "8.24.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.3.1"
  }
}
