# CareBridge environment template. Copy to .env for local development.
# Never commit real secrets. All variables below are server-side only unless marked public.

# --- Required in production (Vercel project settings) ---
# MongoDB connection string from your MongoDB provider (Atlas or compatible).
MONGODB_URI=mongodb://localhost:27017/carebridge

# Random secret of at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Set to "production" on Vercel. This enables secure cookies and the production CSP.
NODE_ENV=development

# --- Local development ---
# Express port. Do not set this on Vercel; serverless functions are routed automatically.
PORT=5000

# Comma-separated exact origins allowed to make credentialed API requests from a
# different domain. Same-host requests are allowed automatically, which covers
# Vercel preview and production URLs.
FRONTEND_ORIGIN=http://localhost:5173

# --- Administrator bootstrap only (npm run seed:admin) ---
ADMIN_NAME=CareBridge Admin
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters

# --- Optional integrations (server-side) ---
# PubMed/NCBI asks clients to identify themselves. Both are optional.
NCBI_EMAIL=
NCBI_API_KEY=

# --- Public client variable (Vite, embedded in the browser build) ---
# Never place secrets in VITE_* variables. This only selects map tiles.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
