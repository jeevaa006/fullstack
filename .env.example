# MongoDB connection string. Use the URI provided by Nimbus or your MongoDB Atlas project.
MONGODB_URI=mongodb://localhost:27017/carebridge

# Generate a random secret of at least 32 characters; never commit the real value.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

PORT=5000
NODE_ENV=development

# Exact origins allowed for credentialed API requests when frontend and API use different domains.
# Same-host website/API requests are allowed automatically.
FRONTEND_ORIGIN=http://localhost:5173

# Set only when bootstrapping an administrator, then run npm run seed:admin.
ADMIN_NAME=CareBridge Admin
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
